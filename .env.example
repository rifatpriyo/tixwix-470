NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APP_URL=http://127.0.0.1:3000

# Optional, integration tests ONLY. Use a dedicated disposable Supabase project.
# The application does not need a service-role key.
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_PUBLISHABLE_KEY=your-test-project-publishable-key
# SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-project-service-role-key
# SUPABASE_TEST_ALLOW_USER_CREATION=true

# Sprint 2 local demo/test process only (never application deployment settings).
# SUPABASE_TEST_DB_URL=postgresql://postgres:LOCAL_PASSWORD@127.0.0.1:54322/postgres
# SUPABASE_TEST_RESERVATIONS=true
# SUPABASE_TEST_EVENT_USERS_FILE=.qa/reservation-demo-users.json
